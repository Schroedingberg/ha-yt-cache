{:paths ["src" "test"]
 :name "youtube-to-media"
 :description "A Home Assistant app to download YouTube videos to media."
 :version "0.1.0"
 :license "Apache-2.0"
 :tasks
 {start
  {:doc "Start the local server. Optional port defaults to 8098."
   :task (let [[requested-port] *command-line-args*
               port (or requested-port "8098")]
           (shell "env" (str "PORT=" port) "DOWNLOAD_DIRECTORY=downloads"
                  "bb" "-m" "youtube-to-media.core"))}
  download
  {:doc "Submit a video URL to the running app. Optional base URL defaults to localhost:8099."
   :requires ([babashka.http-client :as http])
   :task (let [[url app-url] *command-line-args*
               app-url (or app-url
                           (System/getenv "YOUTUBE_TO_MEDIA_URL")
                           "http://127.0.0.1:8099")]
           (when-not url
             (throw (ex-info "Usage: bb download <URL> [APP-URL]" {})))
           (let [token (System/getenv "SUPERVISOR_TOKEN")
                 {:keys [status body]} (http/post (str app-url "/enqueue")
                                                  (cond-> {:body url}
                                                    token (assoc :headers {"Authorization" (str "Bearer " token)})))]
             (when-not (= status 202)
               (throw (ex-info (str "App rejected request with HTTP " status) {:body body})))
             (println (str "Queued job: " body))))}
  test
  {:doc "Run the unit tests."
   :requires ([clojure.test :as t])
   :task (do
           (require 'youtube-to-media.core-test)
           (let [{:keys [fail error]} (t/run-tests 'youtube-to-media.core-test)]
             (when (pos? (+ fail error))
               (System/exit 1))))}
  dev
  {:doc "Local Docker dev loop. Usage: bb dev [build|run|logs|stop] (default run)."
   :task (let [[sub] *command-line-args*
               sub (or sub "run")
               image "yt2m-dev"
               share (or (System/getenv "SHARE") "/mnt/supervisor/share")]
         (case sub
           "build" (shell "docker" "build" "-t" image ".")
           "run" (do
                   (shell "docker" "build" "-t" image ".")
                   (shell {:continue true :out :string :err :string} "docker" "rm" "-f" "yt2m-dev")
                   (shell "docker" "run" "-d" "--name" "yt2m-dev" "-p" "8099:8099"
                          "-v" (str share ":/share")
                          "-e" "DOWNLOAD_DIRECTORY=/share/youtube-to-media"
                          "-e" "PORT=8099"
                          image))
           "logs" (shell "docker" "logs" "-f" "yt2m-dev")
           "stop" (shell {:continue true} "docker" "rm" "-f" "yt2m-dev")
           (println "Usage: bb dev [build|run|logs|stop]")))}}
 :deps {cheshire/cheshire {:mvn/version "5.13.0"}
        http-kit/http-kit {:mvn/version "2.8.0"}}}