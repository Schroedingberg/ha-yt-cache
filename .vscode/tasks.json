{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Home Assistant",
      "type": "shell",
      "command": "supervisor_run",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Production: Install Published App",
      "type": "shell",
      "command": "ha apps install \"local_${input:appName}\"",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Production: Start Published App",
      "type": "shell",
      "command": "ha apps stop \"local_${input:appName}\" || true; ha apps start \"local_${input:appName}\" && ha apps logs -f \"local_${input:appName}\"",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "runOptions": {
        "reevaluateOnRerun": false
      }
    },
    {
      "label": "Production: Update Published App",
      "type": "shell",
      "command": "ha apps update \"local_${input:appName}\"",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Development: Start Local Server",
      "type": "shell",
      "command": "bb -m youtube-to-media.core",
      "options": {
        "cwd": "${workspaceFolder}/youtube-to-media",
        "env": {
          "PORT": "8098",
          "DOWNLOAD_DIRECTORY": "${workspaceFolder}/youtube-to-media/downloads"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "appName",
      "type": "pickString",
      "description": "Name of app (to add your app to this list, please edit .vscode/tasks.json)",
      "options": [
        "youtube-to-media"
      ]
    }
  ]
}
